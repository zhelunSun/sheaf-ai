# Legacy/local scripts are ignored. Only reviewed release helpers are tracked.
scripts/*
!scripts/smoke-pre-release.py
!scripts/release/
!scripts/release/**
# The release allowlist must not re-include generated Python caches.
scripts/release/**/__pycache__/
scripts/release/**/*.pyc

